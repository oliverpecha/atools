{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "state.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "sprint_tag",
    "seq",
    "epoch",
    "status",
    "active_stage",
    "active_spec",
    "active_solution_key",
    "active_oracle_draft",
    "active_oracle",
    "active_contract",
    "attempts",
    "closures_submitted",
    "hard_caps_tripped",
    "grants",
    "tmux_sessions"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "sprint_tag": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z0-9][a-z0-9-]{1,40}$"
    },
    "seq": { "type": "integer", "minimum": 0 },
    "epoch": { "type": "integer", "minimum": 1 },
    "status": {
      "type": "string",
      "enum": ["draft", "running", "hold", "done", "aborted"]
    },
    "active_stage": {
      "type": ["string", "null"],
      "enum": ["intake", "oracle", "implementer", "live", "curator", "closeout", null]
    },
    "active_spec": { "type": ["string", "null"] },
    "active_solution_key": { "type": ["string", "null"] },
    "active_oracle_draft": { "type": ["string", "null"] },
    "active_oracle": { "type": ["string", "null"] },
    "active_contract": { "type": ["string", "null"] },
    "attempts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle", "implementer", "live", "curator"],
      "properties": {
        "oracle": { "type": "integer", "minimum": 0 },
        "implementer": { "type": "integer", "minimum": 0 },
        "live": { "type": "integer", "minimum": 0 },
        "curator": { "type": "integer", "minimum": 0 }
      }
    },
    "closures_submitted": { "type": "integer", "minimum": 0 },
    "hard_caps_tripped": { "type": "integer", "minimum": 0 },
    "grants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle", "implementer", "live", "curator"],
      "properties": {
        "oracle": { "type": "integer", "minimum": 0 },
        "implementer": { "type": "integer", "minimum": 0 },
        "live": { "type": "integer", "minimum": 0 },
        "curator": { "type": "integer", "minimum": 0 }
      }
    },
    "tmux_sessions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
