{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "closure.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["reason", "blocking_step", "notes", "backlog", "solution_key_divergence"],
  "properties": {
    "kind": { "const": "closure" },
    "seq": { "type": "integer", "minimum": 1 },
    "parent": { "type": ["string", "null"] },
    "reason": {
      "type": "string",
      "enum": ["done", "blocked"]
    },
    "blocking_step": { "type": ["string", "null"] },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "backlog": {
      "type": "array",
      "items": { "type": "string" }
    },
    "solution_key_divergence": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["requirement_id", "rationale"],
          "properties": {
            "requirement_id": { "type": "string" },
            "rationale": { "type": "string" }
          }
        }
      ]
    }
  }
}
