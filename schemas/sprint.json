{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sprint.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sprint_tag",
    "base_sha",
    "status",
    "spec_source",
    "after",
    "approval_live_run",
    "solution_key_exposure",
    "owner_review_triggers",
    "min_attempts_before_block",
    "max_epochs",
    "repo_test_cmd",
    "max_attempts",
    "hard_cap"
  ],
  "properties": {
    "sprint_tag": { "type": "string" },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "frozen"]
    },
    "spec_source": {
      "type": "string",
      "enum": ["architect_qna", "imported"]
    },
    "after": {
      "type": "array",
      "items": { "type": "string" }
    },
    "live_run": {
      "type": "string",
      "enum": ["none", "required"]
    },
    "approval_live_run": {
      "type": "string",
      "enum": ["architect", "owner"]
    },
    "solution_key_exposure": {
      "type": "string",
      "enum": ["full", "hidden"]
    },
    "owner_review_triggers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["plan_deviation", "budget_exceeded", "critical_tripwire", "manual_flag"]
      }
    },
    "min_attempts_before_block": { "type": "integer", "minimum": 1 },
    "max_epochs": { "type": "integer", "minimum": 1 },
    "repo_test_cmd": { "type": "string" },
    "max_attempts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oracle", "implementer", "live", "curator"],
      "properties": {
        "oracle": { "type": "integer", "minimum": 1 },
        "implementer": { "type": "integer", "minimum": 1 },
        "live": { "type": "integer", "minimum": 1 },
        "curator": { "type": "integer", "minimum": 1 }
      }
    },
    "hard_cap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "implementer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wall_clock": { "type": "string" },
            "turns": { "type": "integer", "minimum": 0 },
            "tool_calls": { "type": "integer", "minimum": 0 },
            "tokens": { "type": "integer", "minimum": 0 },
            "cost_usd": { "type": "number", "minimum": 0 }
          }
        },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wall_clock": { "type": "string" },
            "turns": { "type": "integer", "minimum": 0 },
            "tool_calls": { "type": "integer", "minimum": 0 },
            "tokens": { "type": "integer", "minimum": 0 },
            "cost_usd": { "type": "number", "minimum": 0 }
          }
        },
        "live": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wall_clock": { "type": "string" },
            "turns": { "type": "integer", "minimum": 0 },
            "tool_calls": { "type": "integer", "minimum": 0 },
            "tokens": { "type": "integer", "minimum": 0 },
            "cost_usd": { "type": "number", "minimum": 0 }
          }
        },
        "curator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "wall_clock": { "type": "string" },
            "turns": { "type": "integer", "minimum": 0 },
            "tool_calls": { "type": "integer", "minimum": 0 },
            "tokens": { "type": "integer", "minimum": 0 },
            "cost_usd": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "frozen" } },
        "required": ["status"]
      },
      "then": {
        "required": ["live_run"]
      }
    }
  ]
}
