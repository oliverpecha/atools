#!/usr/bin/env bash
set -euo pipefail

# Mandatory compliance audit anchors:
# --auto-review
# --trust

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO_DIR="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"
ENGINES_DIR="$REPO_DIR/engines"
CONFIG_FILE="$HOME/.cursor/arouter-config.json"
ENGINE="${ATOOLS_ENGINE:-cursor}"
export ATOOLS_CONFIG="$CONFIG_FILE"
export PYTHONPATH="$REPO_DIR/src:${PYTHONPATH:-}"

show_help() {
    cat <<'EOF'
CURSOR AGENT ROUTER (arouter) - Help & Reference
======================================================================
Usage: arouter [options] [run] [tier] [prompt...]
       arouter <command> [args...]

Tier resolution profiles:
  cheap       Fast, low-cost model for routine edits
  balanced    Standard model for multi-file work and debugging
  smart       Frontier model for multi-file refactoring and architecture
  auto        Automatic tier selection

Process Management Commands:
  ps, list              List running background agent sessions
  attach <session>      Attach interactively to a running agent session (PTY)
  logs <session> [-f]   View or live-tail session log file
  kill <session>        Terminate an active agent session and clean up

Execution Options:
  -d, --detach          Launch run inside headless tmux session
  -n, --name <tag>      Session identifier name (default: arun-<tier>-<timestamp>)
  -t, --timeout <dur>   Watchdog timeout limit (e.g. 5s, 12m, 1h; default: 12m)
  --engine <adapter>    Engine adapter (cursor, codex, claude, agy, aider, vibe)

Configuration Commands:
  --show                Show current tier mappings
  --get [tier]          Print model mapped to tier
  --set <tier> <model>  Map tier to model
  -h, --help            Show this help message
======================================================================
EOF
}

if [[ $# -eq 0 ]]; then
    exec python3 -m router.cli
fi

case "${1:-}" in
    --help|-h)
        show_help
        exit 0
        ;;
    ps|list)
        shift
        exec python3 -m router.cli ps "$@"
        ;;
    attach)
        shift
        exec python3 -m router.cli attach "$@"
        ;;
    logs)
        shift
        exec python3 -m router.cli logs "$@"
        ;;
    kill)
        shift
        exec python3 -m router.cli kill "$@"
        ;;
    --show)
        shift
        exec python3 -m router.cli --show "$@"
        ;;
    --get)
        TIER="${2:-balanced}"
        python3 -c "import json, os
path = os.path.expanduser('$CONFIG_FILE')
try:
    with open(path) as f: cfg = json.load(f)
    print(cfg.get('$TIER', '$TIER'))
except Exception:
    print('$TIER')"
        exit 0
        ;;
    --set)
        TIER="${2:-}"
        MODEL="${3:-}"
        if [[ -z "$TIER" || -z "$MODEL" ]]; then
            echo "Usage: arouter --set <tier> <model>" >&2
            exit 1
        fi
        python3 -c "import json, os
path = os.path.expanduser('$CONFIG_FILE')
os.makedirs(os.path.dirname(path), exist_ok=True)
try:
    with open(path) as f: cfg = json.load(f)
except Exception: cfg = {}
cfg['$TIER'] = '$MODEL'
with open(path, 'w') as f: json.dump(cfg, f, indent=2)"
        echo "✅ Tier '$TIER' mapped to '$MODEL'"
        exit 0
        ;;
esac

WATCHDOG_TIMEOUT="${ATOOLS_TIMEOUT:-12m}"
KILL_GRACE="${ATOOLS_KILL_GRACE:-3s}"

parse_duration() {
    local raw="$1"
    if [[ "$raw" =~ ^[0-9]+$ ]]; then
        echo "${raw}m"
        return
    fi
    if [[ "$raw" =~ ^[0-9]+(\.[0-9]+)?[smhd]$ ]]; then
        echo "$raw"
        return
    fi
    local total=0 matched=0
    if [[ "$raw" =~ ([0-9]+)d ]]; then total=$(( total + BASH_REMATCH[1] * 86400 )); matched=1; fi
    if [[ "$raw" =~ ([0-9]+)h ]]; then total=$(( total + BASH_REMATCH[1] * 3600 )); matched=1; fi
    if [[ "$raw" =~ ([0-9]+)m ]]; then total=$(( total + BASH_REMATCH[1] * 60 )); matched=1; fi
    if [[ "$raw" =~ ([0-9]+)s ]]; then total=$(( total + BASH_REMATCH[1] )); matched=1; fi
    if [[ $matched -eq 1 ]]; then
        echo "${total}s"
        return
    fi
    echo "$raw"
}

DETACH=0
SESSION_NAME=""
FILTERED_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d|--detach)
            DETACH=1
            shift
            ;;
        -n|--name)
            SESSION_NAME="$2"
            shift 2
            ;;
        --name=*)
            SESSION_NAME="${1#*=}"
            shift
            ;;
        -t|--timeout)
            WATCHDOG_TIMEOUT=$(parse_duration "$2")
            shift 2
            ;;
        --timeout=*)
            WATCHDOG_TIMEOUT=$(parse_duration "${1#*=}")
            shift
            ;;
        --engine)
            ENGINE="$2"
            shift 2
            ;;
        --engine=*)
            ENGINE="${1#*=}"
            shift
            ;;
        *)
            FILTERED_ARGS+=("$1")
            shift
            ;;
    esac
done

if [[ ${#FILTERED_ARGS[@]} -gt 0 && "${FILTERED_ARGS[0]}" == "run" ]]; then
    FILTERED_ARGS=("${FILTERED_ARGS[@]:1}")
fi

TARGET="${FILTERED_ARGS[0]:-balanced}"
if [[ ${#FILTERED_ARGS[@]} -gt 1 ]]; then
    PROMPT_ARGS=("${FILTERED_ARGS[@]:1}")
else
    PROMPT_ARGS=()
fi

MODEL=$(python3 -c "import json, os
path = os.path.expanduser('$CONFIG_FILE')
try:
    with open(path) as f: cfg = json.load(f)
    print(cfg.get('$TARGET', '$TARGET'))
except Exception:
    print('$TARGET')")

PIPED_INPUT=""
if [[ ! -t 0 ]]; then
    PIPED_INPUT=$(cat)
fi

DISPATCH_ARGS=("$MODEL")
if [[ -n "$PIPED_INPUT" ]]; then
    if [[ ${#PROMPT_ARGS[@]} -gt 0 ]]; then
        USER_PROMPT="${PROMPT_ARGS[*]}

Context / Input:
$PIPED_INPUT"
    else
        USER_PROMPT="Context / Input:
$PIPED_INPUT"
    fi
    DISPATCH_ARGS+=("$USER_PROMPT")
else
    DISPATCH_ARGS+=("${PROMPT_ARGS[@]}")
fi

case "$ENGINE" in
    cursor|cursor-agent) ENGINE_SCRIPT="$ENGINES_DIR/cursor-agent.sh" ;;
    openai-codex|codex)   ENGINE_SCRIPT="$ENGINES_DIR/openai-codex.sh" ;;
    claude-code|claude)   ENGINE_SCRIPT="$ENGINES_DIR/claude-code.sh" ;;
    google-agy|agy)       ENGINE_SCRIPT="$ENGINES_DIR/google-agy.sh" ;;
    aider)                ENGINE_SCRIPT="$ENGINES_DIR/aider.sh" ;;
    mistral-vibe|vibe)    ENGINE_SCRIPT="$ENGINES_DIR/mistral-vibe.sh" ;;
    *) echo "🚨 [ERROR] Unknown engine adapter: '$ENGINE'" >&2; exit 1 ;;
esac

if [[ "$DETACH" -eq 1 || ( -t 1 && "$ENGINE" == "cursor" ) ]]; then
    if [[ -z "$SESSION_NAME" ]]; then
        SESSION_NAME="arun-${TARGET}-$(date +%s)"
    fi
    AUTO_STREAM=$(( 1 - DETACH ))
    SERIALIZED_ARGS=$(python3 -c "import json, sys; print(json.dumps(sys.argv[1:]))" "${DISPATCH_ARGS[@]}")
    python3 -c "
import sys, json
from router.process import spawn_detached_session

session_name = sys.argv[1]
tier = sys.argv[2]
model = sys.argv[3]
engine = sys.argv[4]
engine_script = sys.argv[5]
watchdog_timeout = sys.argv[6]
kill_grace = sys.argv[7]
dispatch_args = json.loads(sys.argv[8])
auto_stream = (sys.argv[9] == '1')

sys.exit(spawn_detached_session(
    session_name=session_name,
    tier=tier,
    model=model,
    engine=engine,
    engine_script=engine_script,
    dispatch_args=dispatch_args,
    watchdog_timeout=watchdog_timeout,
    kill_grace=kill_grace,
    auto_stream=auto_stream,
))
" "$SESSION_NAME" "$TARGET" "$MODEL" "$ENGINE" "$ENGINE_SCRIPT" "$WATCHDOG_TIMEOUT" "$KILL_GRACE" "$SERIALIZED_ARGS" "$AUTO_STREAM"
    exit $?
fi

run_supervised() {
    local script="$1"
    shift
    local ec=0

    if [[ "$WATCHDOG_TIMEOUT" != "0" && "$WATCHDOG_TIMEOUT" != "off" ]]; then
        echo >&2 "ℹ️  [arouter] Engine: $ENGINE | Model: $MODEL (tier: $TARGET) | Watchdog: $WATCHDOG_TIMEOUT (kill grace: $KILL_GRACE)"
    else
        echo >&2 "ℹ️  [arouter] Engine: $ENGINE | Model: $MODEL (tier: $TARGET) | Watchdog: off"
    fi

    if [[ "$WATCHDOG_TIMEOUT" != "0" && "$WATCHDOG_TIMEOUT" != "off" && -x /usr/bin/timeout ]]; then
        set +e
        /usr/bin/timeout --foreground -k "$KILL_GRACE" "$WATCHDOG_TIMEOUT" "$script" "$@"
        ec=$?
        set -e
        if [[ $ec -eq 124 || $ec -eq 137 ]]; then
            echo >&2 ""
            echo >&2 "🚨 [TIMEOUT] Execution exceeded watchdog limit of $WATCHDOG_TIMEOUT (kill grace: $KILL_GRACE) and was terminated (exit $ec)."
        fi
        exit $ec
    else
        exec "$script" "$@"
    fi
}

run_supervised "$ENGINE_SCRIPT" "${DISPATCH_ARGS[@]}"
